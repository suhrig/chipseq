{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/chipseq/master/assets/schema_input.json",
    "title": "nf-core/chipseq pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.-]+$",
                "errorMessage": "Sample name must be provided and can only contain alphanumeric characters, underscores, dots and dashes",
                "meta": ["id"]
            },
            "fastq_1": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "FastQ file for reads 1 must be provided, cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "fastq_2": {
                "errorMessage": "FastQ file for reads 2 cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                        "format": "file-path"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "replicate": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "Replicate id must be provided and must be a positive integer",
                "meta": ["replicate"]
            },
            "antibody": {
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_.-]+$",
                        "minLength": 1
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ],
                "errorMessage": "Antibody entry can only contain alphanumeric characters, underscores, dots and dashes",
                "meta": ["antibody"]
            },
            "control": {
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_.-]+$",
                        "minLength": 1
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ],
                "errorMessage": "Control sample name can only contain alphanumeric characters, underscores, dots and dashes",
                "meta": ["control"]
            },
            "control_replicate": {
                "anyOf": [
                    {
                        "type": "integer",
                        "minimum": 1
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ],
                "errorMessage": "Control replicate id must be a positive integer when specified",
                "meta": ["control_replicate"]
            }
        },
        "required": ["sample", "fastq_1", "replicate"],
        "dependentRequired": {
            "antibody": ["control"],
            "control": ["antibody", "control_replicate"]
        }
    }
}
